# ──────────────────────────────────────────────
# FreshHub — Firebase environment variables
# Copy this file to .env.local and fill in your values.
# Find them at: Firebase Console → Project Settings → Your apps → Web app
# ──────────────────────────────────────────────
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_APP_ID=

# Optional during App Check rollout. Set only to the reCAPTCHA v3 site key
# registered for this Firebase web app in Firebase Console → App Check.
# Server-side enforcement remains disabled until the production client is verified.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
