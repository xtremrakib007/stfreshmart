rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() {
      return request.auth != null
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function me() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }
    function isStaff() {
      return signed() && me().role in ['staff', 'admin'];
    }
    function isAdmin() {
      return signed() && me().role == 'admin';
    }
    function validCustomerOrder() {
      return request.resource.data.keys().hasOnly([
          'customer', 'method', 'delivery', 'items', 'total', 'status',
          'placedBy', 'message', 'createdAt'
        ])
        && request.resource.data.status == 'Pending'
        && request.resource.data.method in [
          'STANDARD DELIVERY', 'URGENT DELIVERY', 'SELF PICKUP'
        ]
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly(['name', 'phone', 'company'])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() > 0
        && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.company is string
        && request.resource.data.customer.company.size() <= 160
        && request.resource.data.delivery is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.placedBy is string
        && request.resource.data.placedBy.size() <= 40
        && request.resource.data.createdAt == request.time;
    }

    match /products/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      // Private cost and minimum-price fields must never be stored here.
      allow create: if isAdmin()
        && !request.resource.data.keys().hasAny(['purchasePrice', 'minPricePcs', 'minPriceCtn']);
      allow update: if isAdmin()
        && !request.resource.data.keys().hasAny(['purchasePrice', 'minPricePcs', 'minPriceCtn']);
      allow delete: if isAdmin();
    }
    match /productPrivate/{id} {
      allow read, write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /staffPrices/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /orders/{id} {
      // Guest checkout is intentionally supported. Validate the shape here;
      // authoritative pricing and stock checks must also be performed server-side.
      allow create: if false; // Orders must be created by the trusted createOrder callable.
      allow read: if isStaff();
      // Status and stock changes are performed by updateOrderStatus using Admin SDK.
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /priceHistory/{id} {
      allow read, write: if isAdmin();
    }
    match /inventoryHistory/{id} {
      allow read: if isStaff();
      // Admins can record manual stock edits from the product editor; order-driven
      // stock changes are written atomically by updateOrderStatus using Admin SDK.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['sku', 'from', 'to', 'reason', 'at'])
        && request.resource.data.sku is string
        && request.resource.data.sku.size() > 0
        && request.resource.data.sku.size() <= 100
        && request.resource.data.from is number
        && request.resource.data.from >= 0
        && request.resource.data.to is number
        && request.resource.data.to >= 0
        && request.resource.data.reason == 'manual'
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /suppliers/{id} {\n      allow read: if isStaff();\n      // Supplier records are changed only through the admin-guarded saveSupplier callable.\n      allow write: if false;\n    }\n    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}